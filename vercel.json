{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/game/:slug",
      "destination": "/games/:slug/index.html"
    },
    {
      "source": "/game/:slug/:path*",
      "destination": "/games/:slug/:path*"
    },
    {
      "source": "/details/:slug",
      "destination": "/details.html"
    },
    {
      "source": "/about-us",
      "destination": "/about-us.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-conditions",
      "destination": "/terms-conditions.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/how-to-play",
      "destination": "/how-to-play.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/:category([^.]+)",
      "destination": "/index.html"
    }
  ]
}